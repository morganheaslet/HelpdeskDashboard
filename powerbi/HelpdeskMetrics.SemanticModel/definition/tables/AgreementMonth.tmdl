		lineageTag: 4d9567b5-1200-46cf-b8f9-3d6d1b54b2cd

	measure 'Agreement Effective Hourly Rate' = DIVIDE ( [Agreement Revenue], [Agreement Hours] )
		formatString: \$#,0.00
		displayFolder: Agreement
		lineageTag: 80a59c7f-b2f3-4219-9ef3-7acafabbfb84

