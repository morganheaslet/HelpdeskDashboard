		lineageTag: 4be11760-35d0-4a17-a286-a31bcf954443

	measure 'Agreement Effective Hourly Rate' = DIVIDE ( [Agreement Revenue], [Agreement Hours] )
		formatString: \$#,0.00
		displayFolder: Agreement
		lineageTag: 3a3478ee-9755-40b3-b79c-f39dca2c404b

