table AgreementMonth
	lineageTag: 6810f238-a551-4cab-9487-fb701ea9d65a

	measure 'Agreement Revenue' = SUM ( AgreementMonth[Revenue] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: 3a189d6f-b14c-4077-bdf8-37f8f7f16fbb

	measure 'Agreement Labor Cost' = SUM ( AgreementMonth[Labor Cost (raw)] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: 877923cd-d179-4df0-8f9a-28ab91ae74d6

	measure 'Agreement Addition Cost' = SUM ( AgreementMonth[Addition Cost] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: 8790c968-d248-455f-b373-2e4a471bf39d

	measure 'Agreement Margin' = SUM ( AgreementMonth[Margin] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: 017ba859-ac72-42fd-8d63-94d3bf55e96b

	measure 'Agreement Margin %' = DIVIDE ( [Agreement Margin], [Agreement Revenue] )
		formatString: 0.0%
		displayFolder: Agreement
		lineageTag: 4e224263-7965-4ace-8b8b-bcbc1c8ee87b

	measure 'Agreement Hours' = SUM ( AgreementMonth[Hours] )
		formatString: #,0.0
		displayFolder: Agreement
		lineageTag: 1f60bd1f-c918-4a71-afaa-89c2395e81e7

	measure 'Agreement Effective Hourly Rate' = DIVIDE ( [Agreement Revenue], [Agreement Hours] )
		formatString: \$#,0.00
		displayFolder: Agreement
		lineageTag: cb598a95-89a2-4162-b234-d0d29bb6b1af

