table AgreementMonth
	lineageTag: 3fdd9dfb-e0e5-44c0-a04d-0a20371703e7

	measure 'Agreement Revenue' = SUM ( AgreementMonth[Revenue] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: cf157c7b-2244-4f05-9c9f-81232b306e1a

	measure 'Agreement Labor Cost' = SUM ( AgreementMonth[Labor Cost (raw)] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: 335b0cc8-44fa-4e74-87a5-e7602f319aae

	measure 'Agreement Addition Cost' = SUM ( AgreementMonth[Addition Cost] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: b02967f5-158e-4a75-94d6-fb0776ac8ccc

	measure 'Agreement Margin' = SUM ( AgreementMonth[Margin] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: cb4919da-0684-4cc5-b521-320d85e1ba35

	measure 'Agreement Margin %' = DIVIDE ( [Agreement Margin], [Agreement Revenue] )
		formatString: 0.0%
		displayFolder: Agreement
		lineageTag: 15d74461-363a-4f70-b9c4-481a7189f518

	measure 'Agreement Hours' = SUM ( AgreementMonth[Hours] )
		formatString: #,0.0
		displayFolder: Agreement
		lineageTag: e6dbae59-a8d4-4143-8e79-c86223869981

	measure 'Agreement Effective Hourly Rate' = DIVIDE ( [Agreement Revenue], [Agreement Hours] )
		formatString: \$#,0.00
		displayFolder: Agreement
		lineageTag: 283ee900-63ca-45e3-8e28-6627bd794fed

