table AgreementMonth
	lineageTag: 81ee1e2a-bf5d-4cd7-8e5f-6f5453b5fa82

	measure 'Agreement Revenue' = SUM ( AgreementMonth[Revenue] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: 957e49e8-7c6b-48c7-bdd7-c4da9b011dbf

	measure 'Agreement Labor Cost' = SUM ( AgreementMonth[Labor Cost] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: 724d7531-20e9-4b1c-9f67-4c1121b7e704

	measure 'Agreement Addition Cost' = SUM ( AgreementMonth[Addition Cost] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: ed7dcba6-f914-4310-9772-819f74dced8a

	measure 'Agreement Margin' = SUM ( AgreementMonth[Margin] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: 3c8ef754-8979-4f36-afe2-5069bb32733d

	measure 'Agreement Margin %' = DIVIDE ( [Agreement Margin], [Agreement Revenue] )
		formatString: 0.0%
		displayFolder: Agreement
		lineageTag: d0a7ef96-ecda-4193-a45d-1679786beb6a

	measure 'Agreement Hours' = SUM ( AgreementMonth[Hours] )
		formatString: #,0.0
		displayFolder: Agreement
		lineageTag: 1d736ef0-39a6-403a-8fc3-b0ca4bc523fa

	measure 'Agreement Effective Hourly Rate' = DIVIDE ( [Agreement Revenue], [Agreement Hours] )
		formatString: \$#,0.00
		displayFolder: Agreement
		lineageTag: b65fbdd4-3b1d-4318-a213-d847a42e38f4

