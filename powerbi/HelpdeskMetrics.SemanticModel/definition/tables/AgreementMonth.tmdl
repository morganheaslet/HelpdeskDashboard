table AgreementMonth
	lineageTag: 612d3791-4ec2-4fb4-bc8c-bbca9f978265

	measure 'Agreement Revenue' = SUM ( AgreementMonth[Revenue] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: 26b301ed-eb3e-480e-ae19-b3f585043211

	measure 'Agreement Labor Cost' = SUM ( AgreementMonth[Labor Cost (raw)] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: c66f02f7-a097-438b-9b34-d6a93ad07072

	measure 'Agreement Addition Cost' = SUM ( AgreementMonth[Addition Cost] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: c50cc1e5-a9f4-451a-9e22-da0fc6a79a05

	measure 'Agreement Margin' = SUM ( AgreementMonth[Margin] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: 6b07d33f-fd78-4dc0-bd87-65d43e8f2e37

	measure 'Agreement Margin %' = DIVIDE ( [Agreement Margin], [Agreement Revenue] )
		formatString: 0.0%
		displayFolder: Agreement
		lineageTag: 5877a10d-1a92-49ed-ba22-11a905e4f358

	measure 'Agreement Hours' = SUM ( AgreementMonth[Hours] )
		formatString: #,0.0
		displayFolder: Agreement
		lineageTag: c404b2ec-bb00-4138-ac36-e97ed2776db1

	measure 'Agreement Effective Hourly Rate' = DIVIDE ( [Agreement Revenue], [Agreement Hours] )
		formatString: \$#,0.00
		displayFolder: Agreement
		lineageTag: a6e4fea1-f76f-4a81-8e7f-79596b92c993

