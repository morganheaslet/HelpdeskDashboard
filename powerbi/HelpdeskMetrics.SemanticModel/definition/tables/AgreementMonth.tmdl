table AgreementMonth
	lineageTag: fd3659af-2e65-4884-8314-6a0e5e91e485

	measure 'Agreement Revenue' = SUM ( AgreementMonth[Revenue] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: ef026bb4-35ef-4ee4-9ddc-9a85b2f4b5b7

	measure 'Agreement Labor Cost' = SUM ( AgreementMonth[Labor Cost (raw)] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: 2e3f5681-cf25-4775-8a82-11959019cadc

	measure 'Agreement Addition Cost' = SUM ( AgreementMonth[Addition Cost] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: 35c63668-f60b-473a-9424-4464defb58b4

	measure 'Agreement Margin' = SUM ( AgreementMonth[Margin] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Agreement
		lineageTag: 4716278d-855d-4a50-82fc-1f8154641033

	measure 'Agreement Margin %' = DIVIDE ( [Agreement Margin], [Agreement Revenue] )
		formatString: 0.0%
		displayFolder: Agreement
		lineageTag: e60358e6-1dfb-421f-9e94-ff9f2722b1df

	measure 'Agreement Hours' = SUM ( AgreementMonth[Hours] )
		formatString: #,0.0
		displayFolder: Agreement
		lineageTag: 5a77678b-5a85-4fa6-b3f0-85c5908b7f49

	measure 'Agreement Effective Hourly Rate' = DIVIDE ( [Agreement Revenue], [Agreement Hours] )
		formatString: \$#,0.00
		displayFolder: Agreement
		lineageTag: 72b61a0e-b747-421a-83fa-3edca015e66e

