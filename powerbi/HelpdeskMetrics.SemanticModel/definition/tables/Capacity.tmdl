table Capacity
	lineageTag: 356739de-d2e7-4e28-9ab6-b7c1905dc028

	measure 'Capacity Hours' = SUM ( Capacity[Capacity Hours (raw)] )
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: cfa90431-ae86-4214-bf33-3444edb5c192

	measure 'Available Hours' = [Capacity Hours] - [PTO Hours]
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: 6373df06-a170-4e29-b669-c5f5d6abdaff

	measure 'Utilization %' = DIVIDE ( [Utilized Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Utilization
		lineageTag: 5d33ca5c-b471-4def-804d-f14c7dfd8fa9

	measure 'Billable %' = DIVIDE ( [Billable Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Utilization
		lineageTag: 909bf166-c214-4b5f-b2d3-0224fd8df81d

	column TechKey
		dataType: string
		isHidden
		lineageTag: 89fe8cd3-b894-4180-818f-2a3103c8fb76
		summarizeBy: none
		sourceColumn: TechKey

		annotation SummarizationSetBy = Automatic

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 643f0eae-fbf9-4fb0-8817-f10b40ae0262
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Capacity Hours (raw)'
		dataType: double
		isHidden
		formatString: #,0.0
		lineageTag: 75646e7c-eed0-4550-99d1-1bafa82404fd
		summarizeBy: none
		sourceColumn: Capacity Hours

		annotation SummarizationSetBy = Automatic

	partition Capacity = m
		mode: import
		source =
				let
				    Source = Sql.Database(#"SQL Server", #"SQL Database"),
				    Data = Source{[Schema="pbi",Item="Capacity"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table

