table Capacity
	lineageTag: d66ccf89-678e-4603-b68f-28320a7cadce

	measure 'Capacity Hours' = SUM ( Capacity[Capacity Hours (raw)] )
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: 89a9c0b4-96db-4a20-b24f-b9344b96ae13

	measure 'Available Hours' = [Capacity Hours] - [PTO Hours]
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: 8532cc3c-f03b-4edf-8065-4312d183df45

	measure 'Utilization %' = DIVIDE ( [Utilized Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Utilization
		lineageTag: 9fafa560-6185-45bc-8156-8d1436703734

	measure 'Billable %' = DIVIDE ( [Billable Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Utilization
		lineageTag: ec760d0d-2688-48da-8cf2-e01638292b2b

	column TechKey
		dataType: string
		isHidden
		lineageTag: 7b642865-464e-473d-b4b2-d71f4487d157
		summarizeBy: none
		sourceColumn: TechKey

		annotation SummarizationSetBy = Automatic

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: d280cf89-b299-49af-9e72-3358bdc1558a
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	column 'Capacity Hours (raw)'
		dataType: double
		formatString: #,0.0
		isHidden
		lineageTag: c1e619e4-4e23-46e3-94c4-9ed553da385d
		summarizeBy: none
		sourceColumn: Capacity Hours

		annotation SummarizationSetBy = Automatic

	partition Capacity = m
		mode: import
		source =
				let
				    Source = Sql.Database(#"SQL Server", #"SQL Database"),
				    Data = Source{[Schema="pbi",Item="Capacity"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
