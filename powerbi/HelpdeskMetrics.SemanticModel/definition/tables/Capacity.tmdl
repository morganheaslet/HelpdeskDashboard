table Capacity
	lineageTag: 21933d2e-0759-4c65-8d20-164200d3085e

	measure 'Capacity Hours' = SUM ( Capacity[Capacity Hours (raw)] )
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: a8c53e1b-8de0-4578-a921-a981e0267ec3

	measure 'Available Hours' = [Capacity Hours] - [PTO Hours]
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: 4665a638-ebf4-486c-ad30-0a44c930c715

	measure 'Utilization %' = DIVIDE ( [Utilized Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Utilization
		lineageTag: a147edad-bf5e-4fad-a737-946570310174

	measure 'Billable %' = DIVIDE ( [Billable Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Utilization
		lineageTag: 34589bf6-1d6d-4693-92e5-6222e9a825df

	column TechKey
		dataType: string
		isHidden
		lineageTag: 9cef9fbe-2104-41f1-be04-da72ecb5a855
		summarizeBy: none
		sourceColumn: TechKey

		annotation SummarizationSetBy = Automatic

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 516327b7-0fb4-47e7-a38b-ddb7464c4d5e
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	column 'Capacity Hours (raw)'
		dataType: double
		formatString: #,0.0
		isHidden
		lineageTag: 49da3f62-c0e4-4b6d-b42c-ae3cde619fce
		summarizeBy: none
		sourceColumn: Capacity Hours

		annotation SummarizationSetBy = Automatic

	partition Capacity = m
		mode: import
		source =
				let
				    Source = Sql.Database(#"SQL Server", #"SQL Database"),
				    Data = Source{[Schema="pbi",Item="Capacity"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
