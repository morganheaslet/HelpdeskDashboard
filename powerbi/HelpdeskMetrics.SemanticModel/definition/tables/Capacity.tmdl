table Capacity
	lineageTag: 38a2a29c-dfa1-47d3-8151-e267aba2dba4

	measure 'Capacity Hours' = SUM ( Capacity[Capacity Hours (raw)] )
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: 6e9bb4d8-1992-40cb-aef3-ab0f9b944f90

	measure 'Available Hours' = [Capacity Hours] - [PTO Hours]
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: 7a47b982-7982-4c99-8524-50bcc33ae94d

	measure 'Utilization %' = DIVIDE ( [Utilized Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Utilization
		lineageTag: 090bbb65-91fe-47ba-b3dc-4704b0361490

	measure 'Billable %' = DIVIDE ( [Billable Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Utilization
		lineageTag: b7d9a44e-af1a-47d5-b0fa-1d7d9aeb9f42

	column TechKey
		dataType: string
		isHidden
		lineageTag: 93e3a74e-1f12-415e-80c7-d40eea9e7a0b
		summarizeBy: none
		sourceColumn: TechKey

		annotation SummarizationSetBy = Automatic

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: c5fdcbf7-f3fd-4443-b920-e3930c8bfb9f
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	column 'Capacity Hours (raw)'
		dataType: double
		formatString: #,0.0
		isHidden
		lineageTag: 72a72818-e305-4cb9-9d01-f0cf28a6c73e
		summarizeBy: none
		sourceColumn: Capacity Hours

		annotation SummarizationSetBy = Automatic

	partition Capacity = m
		mode: import
		source =
				let
				    Source = Sql.Database(#"SQL Server", #"SQL Database"),
				    Data = Source{[Schema="pbi",Item="Capacity"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
