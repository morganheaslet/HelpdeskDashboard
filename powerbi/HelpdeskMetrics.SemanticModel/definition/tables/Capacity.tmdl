table Capacity
	lineageTag: 6b37b4d7-0d31-4eb4-8f04-b0b748757a68

	measure 'Capacity Hours' = SUM ( Capacity[Capacity Hours (raw)] )
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: 189f7638-d175-44fe-8642-5c0ad77ba2bd

	measure 'Available Hours' = [Capacity Hours] - [PTO Hours]
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: 2735ddec-10d4-4c73-b66f-fbae8e2fdcdc

	measure 'Utilization %' = DIVIDE ( [Utilized Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Utilization
		lineageTag: 5819e8a4-9f7b-419f-8d67-7409207e8352

	measure 'Billable %' = DIVIDE ( [Billable Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Utilization
		lineageTag: 90e632c8-059a-46b9-b53d-d7c5f4add063

	column TechKey
		dataType: string
		isHidden
		lineageTag: dd6fa5b5-bf4b-4659-b5a8-b2981210b663
		summarizeBy: none
		sourceColumn: TechKey

		annotation SummarizationSetBy = Automatic

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: b324682f-02ae-4bbd-a598-7df7a34807c0
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Capacity Hours (raw)'
		dataType: double
		isHidden
		formatString: #,0.0
		lineageTag: c482e45f-dae9-4f38-a55f-6f116e5e46ac
		summarizeBy: none
		sourceColumn: Capacity Hours

		annotation SummarizationSetBy = Automatic

	partition Capacity = m
		mode: import
		source =
				let
				    Source = Sql.Database(#"SQL Server", #"SQL Database"),
				    Data = Source{[Schema="pbi",Item="Capacity"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table

