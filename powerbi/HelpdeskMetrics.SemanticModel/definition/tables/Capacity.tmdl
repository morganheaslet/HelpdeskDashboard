table Capacity
	lineageTag: fdf7422b-a10d-42f9-8476-71f347d27794

	measure 'Capacity Hours' = SUM ( Capacity[Capacity Hours (raw)] )
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: 3af62459-07c3-4b2f-9b3f-89cf4b400bc3

	measure 'Available Hours' = [Capacity Hours] - [PTO Hours]
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: abbd2bb8-e3f3-458e-bc05-0776453f6bcd

	measure 'Utilization %' = DIVIDE ( [Utilized Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Utilization
		lineageTag: e2c9132b-8267-4960-bf6a-244abf86d75a

	measure 'Billable %' = DIVIDE ( [Billable Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Utilization
		lineageTag: beb5a12d-5aed-4391-af8b-b0bc3f525257

	column TechKey
		dataType: string
		isHidden
		lineageTag: 2a37bff9-6139-45c4-8667-2446952d2841
		summarizeBy: none
		sourceColumn: TechKey

		annotation SummarizationSetBy = Automatic

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 7a2fc9b9-357a-440e-a140-d652ad7a7ce8
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	column 'Capacity Hours (raw)'
		dataType: double
		formatString: #,0.0
		isHidden
		lineageTag: 2c494b05-eb8c-48b3-bb38-feae8a71da3b
		summarizeBy: none
		sourceColumn: Capacity Hours

		annotation SummarizationSetBy = Automatic

	partition Capacity = m
		mode: import
		source =
				let
				    Source = Sql.Database(#"SQL Server", #"SQL Database"),
				    Data = Source{[Schema="pbi",Item="Capacity"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
