table PhoneDaily
	lineageTag: efa42505-95f3-4cdf-bb31-3dae2b18d5fd

	measure 'Inbound Calls' = SUM ( PhoneDaily[Inbound Calls (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: b66b06f7-6853-4363-832d-fcbbd658d959

	measure 'Calls Answered' = SUM ( PhoneDaily[Answered] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: c025846a-4902-4370-95d2-58b560340555

	measure 'Calls Missed' = SUM ( PhoneDaily[Missed] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 7e5955b8-a6d8-4981-a456-ad18f8820df3

	measure 'Answer Rate' = DIVIDE ( [Calls Answered], [Inbound Calls] )
		formatString: 0.0%
		displayFolder: Phones
		lineageTag: 3ad0f1c6-9200-41a2-b3bc-047cd0c9da6a

	measure 'Talk Hours' = SUM ( PhoneDaily[Talk Hours (raw)] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: a5187438-674f-4e92-9ea0-0663049db7a8

