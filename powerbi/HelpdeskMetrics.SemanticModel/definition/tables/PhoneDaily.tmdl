table PhoneDaily
	lineageTag: ee61961c-7fe5-4618-926b-87d736cb3a8c

	measure 'Inbound Calls' = SUM ( PhoneDaily[Inbound Calls] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 3bd892b7-b28f-4a11-b8f8-b66eb7ed4e1f

	measure 'Calls Answered' = SUM ( PhoneDaily[Answered] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: ee191783-18b2-4b27-990f-2f0a16798373

	measure 'Calls Missed' = SUM ( PhoneDaily[Missed] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: d2578a35-40fa-48ec-82c3-3a5b4d52c321

	measure 'Answer Rate' = DIVIDE ( [Calls Answered], [Inbound Calls] )
		formatString: 0.0%
		displayFolder: Phones
		lineageTag: dc9f4eef-5e71-4433-ab67-082f2b46ea83

	measure 'Talk Hours' = SUM ( PhoneDaily[Talk Hours] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: 38b9a6c8-0477-4e89-a242-82cdab63bb26

	column Date
		dataType: dateTime
