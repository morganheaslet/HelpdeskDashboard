table PhoneDaily
	lineageTag: a9fdef69-7f7f-4745-b3b8-af7da36c39e7

	measure 'Inbound Calls' = SUM ( PhoneDaily[Inbound Calls (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: dad60ba7-5132-4f44-ac34-4f009f492be3

	measure 'Calls Answered' = SUM ( PhoneDaily[Answered] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 9edcd8ea-b40b-4672-8935-11ad44ee4b15

	measure 'Calls Missed' = SUM ( PhoneDaily[Missed] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 259da6b9-1ad0-4063-8413-69d19801b092

	measure 'Answer Rate' = DIVIDE ( [Calls Answered], [Inbound Calls] )
		formatString: 0.0%
		displayFolder: Phones
		lineageTag: 3930b351-942a-41e1-8b95-c23fed8dfd49

	measure 'Talk Hours' = SUM ( PhoneDaily[Talk Hours (raw)] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: aebfd3e7-8bab-404f-bcd5-875408743d9e

