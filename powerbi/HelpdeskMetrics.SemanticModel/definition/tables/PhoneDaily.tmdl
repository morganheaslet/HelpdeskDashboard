table PhoneDaily
	lineageTag: 542650a0-ad48-4d26-8dd4-815a591bc25d

	measure 'Inbound Calls' = SUM ( PhoneDaily[Inbound Calls (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: ad0a019b-49e1-4804-8625-57a3d2fbdb5d

	measure 'Calls Answered' = SUM ( PhoneDaily[Answered] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: c4749554-1a44-4fa0-9ce0-1e54578a4d59

	measure 'Calls Missed' = SUM ( PhoneDaily[Missed] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: d40308ef-4254-40ec-b83b-71b585f6d2da

	measure 'Answer Rate' = DIVIDE ( [Calls Answered], [Inbound Calls] )
		formatString: 0.0%
		displayFolder: Phones
		lineageTag: 66911cef-d85f-451c-aa5d-41986f2ecb4a

	measure 'Rejected Calls' = SUM ( PhoneDaily[Rejected] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: bbbb5b8a-3dd5-4e8c-8775-81fe0b933663

	measure 'Ring No Answer' = SUM ( PhoneDaily[Ring No Answer (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: c6abf355-10bc-4a08-bae0-a825805ff339

	measure Voicemails = SUM ( PhoneDaily[Voicemails (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 9e1ef92f-2847-437c-bb22-f7e532924178

	measure 'Outbound Calls' = SUM ( PhoneDaily[Outbound Calls (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: a25faf73-2304-4d2b-9b90-38fb8b2d469c

	measure 'Outbound Connected' = SUM ( PhoneDaily[Outbound Connected (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 3dd5fab8-a949-4fae-8ddc-52da59ff5805

	measure 'Calls Handled' = SUM ( PhoneDaily[Handled] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: eb9efd84-9609-437e-82b0-0b29741caf46

	measure 'Transfers Out' = SUM ( PhoneDaily[Transfers Out (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 3f74e9df-7673-4c72-8231-c6dae5fc59cc

	measure 'Talk Hours' = SUM ( PhoneDaily[Talk Hours (raw)] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: 3afda6e9-c03f-4bb0-9b14-9780726ec02f

	measure 'Hold Hours' = SUM ( PhoneDaily[Hold Seconds] ) / 3600
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: ae7191ba-d1a3-41b5-8be5-f5f45eebc878

	measure 'Avg Talk Time (min)' = DIVIDE ( SUM ( PhoneDaily[Talk Seconds] ) / 60, [Calls Handled] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: 5a069909-b56e-440a-b9ff-448cbb603e27

	measure 'Avg Hold Time (min)' = DIVIDE ( SUM ( PhoneDaily[Hold Seconds] ) / 60, [Calls Handled] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: 6ae4a57b-4aaf-42fd-984c-79a719aa9dec

	measure 'Avg Ring Time (sec)' = DIVIDE ( SUM ( PhoneDaily[Ring Seconds] ), [Inbound Calls] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 515c43cf-dc31-47a2-8304-f72127630976

	measure 'Days on Phones' = CALCULATE ( DISTINCTCOUNT ( PhoneDaily[Date] ), PhoneDaily[Handled] > 0 )
		formatString: #,0
		displayFolder: Phones
		lineageTag: db6da602-7ed3-4fac-9b2d-8a66710df3e2

	measure 'Calls per Day' = DIVIDE ( [Calls Handled], [Days on Phones] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: 0a454795-f560-4586-8252-735dd9408d98

	measure 'Talk % of Available Hours' = DIVIDE ( [Talk Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Phones
		lineageTag: 51cdf854-c29b-4f4f-a0f0-77d4517169b2

