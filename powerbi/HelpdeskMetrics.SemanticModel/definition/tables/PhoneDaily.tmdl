table PhoneDaily
	lineageTag: 463a9e9f-f03d-4d38-8897-cf64deabf1ee

	measure 'Inbound Calls' = SUM ( PhoneDaily[Inbound Calls (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: da84f675-cb03-4913-9ebe-7e451f064d16

	measure 'Calls Answered' = SUM ( PhoneDaily[Answered] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 43677647-b9cb-47d9-a62e-fd7763819746

	measure 'Calls Missed' = SUM ( PhoneDaily[Missed] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 913b31bd-0475-4a4d-adf7-4273b4420d7a

	measure 'Answer Rate' = DIVIDE ( [Calls Answered], [Inbound Calls] )
		formatString: 0.0%
		displayFolder: Phones
		lineageTag: ae73d289-595a-4ea9-9f5c-1fb8a177b517

	measure 'Talk Hours' = SUM ( PhoneDaily[Talk Hours (raw)] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: 88e0c9ad-99ea-4cd0-a145-130df6c7c8f0

	measure 'Rejected Calls' = SUM ( PhoneDaily[Rejected] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 65a7a899-e648-407a-ab57-bcfc11c83fd4

	measure 'Ring No Answer' = SUM ( PhoneDaily[Ring No Answer (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 64bf7b05-0837-4c5f-a599-4dc18c4f660f

	measure Voicemails = SUM ( PhoneDaily[Voicemails (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 10857a3b-2efa-47b9-be0b-1e48f00e3e6d

	measure 'Outbound Calls' = SUM ( PhoneDaily[Outbound Calls (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 6dd4cf18-d43f-40d5-a8bb-236da8dd437c

	measure 'Outbound Connected' = SUM ( PhoneDaily[Outbound Connected (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: cf8d7a00-5acf-4a9c-88de-9f17a2612a49

	measure 'Calls Handled' = SUM ( PhoneDaily[Handled] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 8a82af3c-4a39-46a1-8832-f01a721e78e6

	measure 'Transfers Out' = SUM ( PhoneDaily[Transfers Out (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 4449896d-a4e9-4f14-92f1-8e4d9b188fbd

	measure 'Hold Hours' = SUM ( PhoneDaily[Hold Seconds] ) / 3600
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: a3796f64-2a58-4cc4-807e-c9ab7e038da3

	measure 'Avg Talk Time (min)' = DIVIDE ( SUM ( PhoneDaily[Talk Seconds] ) / 60, [Calls Handled] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: c977239a-e1d3-47b4-a413-d2a97f0b0024

	measure 'Avg Hold Time (min)' = DIVIDE ( SUM ( PhoneDaily[Hold Seconds] ) / 60, [Calls Handled] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: 2047d3b7-1a62-4499-8c83-87999d258ee5

	measure 'Avg Ring Time (sec)' = DIVIDE ( SUM ( PhoneDaily[Ring Seconds] ), [Inbound Calls] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: a53c4d55-0d0f-4137-8d52-3babd61f454a

	measure 'Days on Phones' = CALCULATE ( DISTINCTCOUNT ( PhoneDaily[Date] ), PhoneDaily[Handled] > 0 )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 8852ae28-f6c4-40b9-9f29-144fd4abbf33

	measure 'Calls per Day' = DIVIDE ( [Calls Handled], [Days on Phones] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: 7347c09c-3f44-4b8d-b5b8-26ce219d6786

	measure 'Talk % of Available Hours' = DIVIDE ( [Talk Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Phones
		lineageTag: 135ea83b-a5e7-48d1-95f6-d87a2169ecc0

