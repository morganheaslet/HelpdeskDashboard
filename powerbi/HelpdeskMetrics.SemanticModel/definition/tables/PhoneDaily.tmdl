table PhoneDaily
	lineageTag: 41ca2f2f-1198-47c6-9c63-294d4fed3548

	measure 'Inbound Calls' = SUM ( PhoneDaily[Inbound Calls (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: d185be6f-0dd3-4537-b98c-2762ec19e439

	measure 'Calls Answered' = SUM ( PhoneDaily[Answered] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 0cb38b78-7f35-4beb-9eef-4480a7b6173f

	measure 'Calls Missed' = SUM ( PhoneDaily[Missed] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 39ece3e8-4be5-4408-926d-2ea6f72297ed

	measure 'Answer Rate' = DIVIDE ( [Calls Answered], [Inbound Calls] )
		formatString: 0.0%
		displayFolder: Phones
		lineageTag: 4e45f9f1-92f5-4764-a0b6-aeb7c6352f69

	measure 'Rejected Calls' = SUM ( PhoneDaily[Rejected] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 3aba45ec-3369-4b80-beb9-4f8ab8ddf860

	measure 'Ring No Answer' = SUM ( PhoneDaily[Ring No Answer (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 8d0e15f7-5b09-4b86-abae-490babfa3263

	measure Voicemails = SUM ( PhoneDaily[Voicemails (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: dfad06ba-67fc-42bd-bed9-e704536a3bd9

	measure 'Outbound Calls' = SUM ( PhoneDaily[Outbound Calls (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 49b13419-93a2-4656-85e4-d2529bc8609c

	measure 'Outbound Connected' = SUM ( PhoneDaily[Outbound Connected (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 17d7d551-a73b-45b6-80bf-e4d3277389d6

	measure 'Calls Handled' = SUM ( PhoneDaily[Handled] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 3973d0a6-bbbc-49a4-80bf-8220f9b683e1

	measure 'Transfers Out' = SUM ( PhoneDaily[Transfers Out (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 40c90c23-e2de-4150-be08-844f6c9f4f9e

	measure 'Talk Hours' = SUM ( PhoneDaily[Talk Hours (raw)] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: 5b752cfc-b41a-4dbf-8cff-b9c515973fdd

	measure 'Hold Hours' = SUM ( PhoneDaily[Hold Seconds] ) / 3600
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: accf0905-eb69-4b25-baf7-ecc174e42727

	measure 'Avg Talk Time (min)' = DIVIDE ( SUM ( PhoneDaily[Talk Seconds] ) / 60, [Calls Handled] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: b8f192b0-e0e6-435f-92ef-3a4c5e1e5506

	measure 'Avg Hold Time (min)' = DIVIDE ( SUM ( PhoneDaily[Hold Seconds] ) / 60, [Calls Handled] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: 10841b6e-83ad-4293-8761-3938307fd743

	measure 'Avg Ring Time (sec)' = DIVIDE ( SUM ( PhoneDaily[Ring Seconds] ), [Inbound Calls] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 8eaff0da-61da-4b41-bac6-68f6b3168760

	measure 'Days on Phones' = CALCULATE ( DISTINCTCOUNT ( PhoneDaily[Date] ), PhoneDaily[Handled] > 0 )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 1821546b-e310-455d-a52f-41731c154717

	measure 'Calls per Day' = DIVIDE ( [Calls Handled], [Days on Phones] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: 0ea3c52d-1cf6-44e7-b098-7df11f828943

	measure 'Talk % of Available Hours' = DIVIDE ( [Talk Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Phones
		lineageTag: 17edb9bf-0ce2-4af9-92a3-59191e0b540a

