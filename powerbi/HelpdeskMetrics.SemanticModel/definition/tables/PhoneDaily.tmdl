table PhoneDaily
	lineageTag: 0d37b28d-8512-4f1a-a8a7-cdc5cd5780a4

	measure 'Inbound Calls' = SUM ( PhoneDaily[Inbound Calls (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: af367809-b47d-4ebf-8231-7fb453738a2f

	measure 'Calls Answered' = SUM ( PhoneDaily[Answered] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 7c512fd2-441d-427a-95b2-390a28b6cb89

	measure 'Calls Missed' = SUM ( PhoneDaily[Missed] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: d1fce0cc-4f90-446b-a305-5f8d11e0f01a

	measure 'Answer Rate' = DIVIDE ( [Calls Answered], [Inbound Calls] )
		formatString: 0.0%
		displayFolder: Phones
		lineageTag: ba1cc3ab-1b7c-4c51-9ca4-b8e574501f84

	measure 'Rejected Calls' = SUM ( PhoneDaily[Rejected] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 9497f7c1-0c27-4448-b95b-05b7198ce5a6

	measure 'Ring No Answer' = SUM ( PhoneDaily[Ring No Answer (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: b95de566-bc1b-47cc-a821-afb2ca1eeb66

	measure Voicemails = SUM ( PhoneDaily[Voicemails (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 55236123-0691-431f-93cd-c3e0cafac691

	measure 'Outbound Calls' = SUM ( PhoneDaily[Outbound Calls (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 8e512360-028b-481b-84ab-80b3dbad3da0

	measure 'Outbound Connected' = SUM ( PhoneDaily[Outbound Connected (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: da3aefb1-8d46-42b3-9d7d-77443326bf49

	measure 'Calls Handled' = SUM ( PhoneDaily[Handled] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 7b89b8e1-69b4-4fac-988a-507577f79464

	measure 'Transfers Out' = SUM ( PhoneDaily[Transfers Out (raw)] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 4ba46c65-727d-4506-b34a-9d5c6f7b5289

	measure 'Talk Hours' = SUM ( PhoneDaily[Talk Hours (raw)] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: 8e3704e7-fdae-41f4-a971-cb16eaf46e1a

	measure 'Hold Hours' = SUM ( PhoneDaily[Hold Seconds] ) / 3600
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: f4336f68-de65-452a-ab43-592e2bfea416

	measure 'Avg Talk Time (min)' = DIVIDE ( SUM ( PhoneDaily[Talk Seconds] ) / 60, [Calls Handled] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: f34f21d2-1cbb-42a8-94df-e99217406a47

	measure 'Avg Hold Time (min)' = DIVIDE ( SUM ( PhoneDaily[Hold Seconds] ) / 60, [Calls Handled] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: 287fd708-6a21-4dd7-8054-6e11cb8100a8

	measure 'Avg Ring Time (sec)' = DIVIDE ( SUM ( PhoneDaily[Ring Seconds] ), [Inbound Calls] )
		formatString: #,0
		displayFolder: Phones
		lineageTag: 0f95835b-7d18-4b24-986a-d881eddff1cf

	measure 'Days on Phones' = CALCULATE ( DISTINCTCOUNT ( PhoneDaily[Date] ), PhoneDaily[Handled] > 0 )
		formatString: #,0
		displayFolder: Phones
		lineageTag: d6c22de5-fba7-432e-b28d-a48a7de108db

	measure 'Calls per Day' = DIVIDE ( [Calls Handled], [Days on Phones] )
		formatString: #,0.0
		displayFolder: Phones
		lineageTag: 1ffea5e1-f437-46dd-9e7d-c86a4e326fe4

	measure 'Talk % of Available Hours' = DIVIDE ( [Talk Hours], [Available Hours] )
		formatString: 0.0%
		displayFolder: Phones
		lineageTag: 6d43476f-a8c0-49ad-8512-22c6a89eeb54

