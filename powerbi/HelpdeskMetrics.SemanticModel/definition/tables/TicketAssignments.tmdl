table TicketAssignments
	lineageTag: c42ef06a-3925-4961-b0f4-051187488846

	measure 'Tickets Assigned' = COUNTROWS ( TicketAssignments )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 8bee5a99-904e-40e6-a25b-ae404d9eff7a

	measure 'Assigned - Closed' = [Tickets Assigned] - [Tickets Closed]
		formatString: +#,0;-#,0;0
		displayFolder: Volume
		lineageTag: 5422071f-561d-4b22-a5b6-9db5e0482fa8

	measure 'Close Rate' = DIVIDE ( [Tickets Closed], [Tickets Assigned] )
		formatString: 0.0%
		displayFolder: Volume
		lineageTag: 8948a316-0537-4ca0-8a76-fe138657b4b6

