table TicketAssignments
	lineageTag: 090023a1-9a91-4c14-ace5-5924ab7868e3

	measure 'Tickets Assigned' = COUNTROWS ( TicketAssignments )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 296101d1-d12e-492f-99fc-1651d5f9716e

	measure 'Assigned - Closed' = [Tickets Assigned] - [Tickets Closed]
		formatString: +#,0;-#,0;0
		displayFolder: Volume
		lineageTag: 6c1294b2-1fab-4448-92f6-cd027050031b

	measure 'Close Rate' = DIVIDE ( [Tickets Closed], [Tickets Assigned] )
		formatString: 0.0%
		displayFolder: Volume
		lineageTag: 93578b57-a54e-4236-8156-304561dd444a

