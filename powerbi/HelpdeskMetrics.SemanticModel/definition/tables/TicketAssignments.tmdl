table TicketAssignments
	lineageTag: df4cb905-b63c-4129-a103-0578734ef73f

	measure 'Tickets Assigned' = COUNTROWS ( TicketAssignments )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 68e0f5d3-e339-4d0f-9e64-8c3ce508956a

	measure 'Assigned - Closed' = [Tickets Assigned] - [Tickets Closed]
		formatString: +#,0;-#,0;0
		displayFolder: Volume
		lineageTag: e11788f4-a554-4044-9b8e-04cb0fb8627e

	measure 'Close Rate' = DIVIDE ( [Tickets Closed], [Tickets Assigned] )
		formatString: 0.0%
		displayFolder: Volume
		lineageTag: a939bf00-e092-4771-a654-29ca0ce5bd71

