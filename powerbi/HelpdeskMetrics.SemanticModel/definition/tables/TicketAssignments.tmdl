table TicketAssignments
	lineageTag: fac9e041-1841-49c4-8349-5ac07d3a8703

	measure 'Tickets Assigned' = COUNTROWS ( TicketAssignments )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 7272d919-bb8c-4706-8c67-ed33ae6560e8

	measure 'Assigned - Closed' = [Tickets Assigned] - [Tickets Closed]
		formatString: +#,0;-#,0;0
		displayFolder: Volume
		lineageTag: 705eadeb-67ed-4d4b-8315-2cb56d5e470a

	measure 'Close Rate' = DIVIDE ( [Tickets Closed], [Tickets Assigned] )
		formatString: 0.0%
		displayFolder: Volume
		lineageTag: dd9ca616-8048-4c0f-a677-e79888e58bd7

