table TicketAssignments
	lineageTag: 83e63e04-7f96-4db2-8fa0-68a99bd5cadb

	measure 'Tickets Assigned' = COUNTROWS ( TicketAssignments )
		formatString: #,0
		displayFolder: Volume
		lineageTag: a49e8916-5057-45fc-b348-f3d28984b430

	measure 'Assigned - Closed' = [Tickets Assigned] - [Tickets Closed]
		formatString: +#,0;-#,0;0
		displayFolder: Volume
		lineageTag: 2669d8c5-7d20-4fce-ab37-ecbaab199f60

	measure 'Close Rate' = DIVIDE ( [Tickets Closed], [Tickets Assigned] )
		formatString: 0.0%
		displayFolder: Volume
		lineageTag: e45d6f62-b2b5-4ae7-ba53-0637e52b24c7

