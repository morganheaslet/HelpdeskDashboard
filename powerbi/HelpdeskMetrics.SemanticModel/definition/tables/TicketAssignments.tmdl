table TicketAssignments
	lineageTag: b6ed947a-48db-4997-a515-eac3e2db0342

	measure 'Tickets Assigned' = COUNTROWS ( TicketAssignments )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 1ce7216b-0427-431d-b2db-6bd6ca0594f9

	measure 'Assigned - Closed' = [Tickets Assigned] - [Tickets Closed]
		formatString: +#,0;-#,0;0
		displayFolder: Volume
		lineageTag: 442e78fe-253b-473e-923e-ef161f23ced6

	measure 'Close Rate' = DIVIDE ( [Tickets Closed], [Tickets Assigned] )
		formatString: 0.0%
		displayFolder: Volume
		lineageTag: 3f688a53-eb83-45c0-9761-9c4374d3baed

