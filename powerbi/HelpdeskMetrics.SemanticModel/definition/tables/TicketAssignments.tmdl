table TicketAssignments
	lineageTag: f7c419c7-6f30-4c87-a631-89acdfbe7623

	measure 'Tickets Assigned' = COUNTROWS ( TicketAssignments )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 1d14aff1-7417-431d-8851-b686825be8f9

	measure 'Assigned - Closed' = [Tickets Assigned] - [Tickets Closed]
		formatString: +#,0;-#,0;0
		displayFolder: Volume
		lineageTag: f50374a9-0f19-4866-9cb1-43c293f0da94

	measure 'Close Rate' = DIVIDE ( [Tickets Closed], [Tickets Assigned] )
		formatString: 0.0%
		displayFolder: Volume
		lineageTag: 32211999-88a0-4f8d-a13e-9a20ca26ee93

