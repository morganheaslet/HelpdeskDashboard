table Tickets
	lineageTag: 73d1dca7-5f74-455a-bacb-b8fe1718d634

	measure 'Tickets Opened' = COUNTROWS ( Tickets )
		formatString: #,0
		displayFolder: Volume
		lineageTag: c8d2ab92-38b0-4afb-9199-f834a0f9e9a9

	measure 'Tickets Closed' = CALCULATE ( COUNTROWS ( Tickets ), Tickets[Is Closed] = TRUE (), USERELATIONSHIP ( Tickets[Closed Date], 'Calendar'[Date] ), USERELATIONSHIP ( Tickets[CloserKey], Tech[TechKey] ) )
		formatString: #,0
		displayFolder: Volume
		lineageTag: bd5ad7c5-3420-41ab-aa5c-a584153f6f23

	measure 'Tickets Resolved' = CALCULATE ( COUNTROWS ( Tickets ), NOT ISBLANK ( Tickets[Resolved Date] ), USERELATIONSHIP ( Tickets[Resolved Date], 'Calendar'[Date] ), USERELATIONSHIP ( Tickets[ResolverKey], Tech[TechKey] ) )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 55a0a064-3d04-4ef4-a168-9e39e6ba6596

	measure 'Open Now' = CALCULATE ( COUNTROWS ( Tickets ), Tickets[Is Open] = TRUE (), REMOVEFILTERS ( 'Calendar' ) )
		formatString: #,0
		displayFolder: Backlog
		lineageTag: 8a86bbd1-24ef-4197-949c-16b305b0b525

	measure 'Open at End of Period' = VAR d = MIN ( MAX ( 'Calendar'[Date] ), TODAY () ) RETURN IF ( MIN ( 'Calendar'[Date] ) > TODAY (), BLANK (), CALCULATE ( COUNTROWS ( Tickets ), REMOVEFILTERS ( 'Calendar' ), Tickets[Entered Date] <= d, FILTER ( ALL ( Tickets[Done Date] ), ISBLANK ( Tickets[Done Date] ) || Tickets[Done Date] > d ) ) )
		formatString: #,0
		displayFolder: Backlog
		lineageTag: 78bbbbfc-9a85-46f5-ae07-88d44469ca05

	measure 'Waiting Now' = CALCULATE ( COUNTROWS ( Tickets ), Tickets[Is Open] = TRUE (), Tickets[Is Waiting] = TRUE (), REMOVEFILTERS ( 'Calendar' ) )
		formatString: #,0
		displayFolder: Backlog
		lineageTag: 66d1462f-d56d-4e63-b915-cc0b350e6633

	measure 'Avg Open Age (Days)' = CALCULATE ( AVERAGE ( Tickets[Open Age Days] ), Tickets[Is Open] = TRUE (), REMOVEFILTERS ( 'Calendar' ) )
		formatString: #,0.0
		displayFolder: Backlog
		lineageTag: 81ab9786-fe0a-49f4-8863-07337ce92e61

	measure 'Out of SLA Now' = CALCULATE ( COUNTROWS ( Tickets ), Tickets[Is Open] = TRUE (), Tickets[Is In SLA Now] = FALSE (), REMOVEFILTERS ( 'Calendar' ) )
		formatString: #,0
		displayFolder: SLA
		lineageTag: 406f2a48-c1a9-49b9-9095-fd4f369dd546

	measure 'Responses With SLA Target' = CALCULATE ( COUNTROWS ( Tickets ), NOT ISBLANK ( Tickets[Met Response SLA] ) )
		formatString: #,0
		displayFolder: SLA
		lineageTag: e23fed11-8b59-4e65-b4fd-b236984c3140

	measure 'Response SLA %' = DIVIDE ( CALCULATE ( COUNTROWS ( Tickets ), Tickets[Met Response SLA] = 1 ), [Responses With SLA Target] )
		formatString: 0.0%
		displayFolder: SLA
		lineageTag: 41cb27b2-b98d-4a44-967b-8f9d3d93c5c9

	measure 'Resolutions With SLA Target' = CALCULATE ( COUNTROWS ( Tickets ), NOT ISBLANK ( Tickets[Met Resolution SLA] ), Tickets[Is Closed] = TRUE (), USERELATIONSHIP ( Tickets[Closed Date], 'Calendar'[Date] ) )
		formatString: #,0
		displayFolder: SLA
		lineageTag: 2f4beffb-7f52-4ee1-9ed6-1819ca63b014

	measure 'Resolution SLA %' = DIVIDE ( CALCULATE ( COUNTROWS ( Tickets ), Tickets[Met Resolution SLA] = 1, Tickets[Is Closed] = TRUE (), USERELATIONSHIP ( Tickets[Closed Date], 'Calendar'[Date] ) ), [Resolutions With SLA Target] )
		formatString: 0.0%
		displayFolder: SLA
		lineageTag: b3da1f13-6d43-4c9f-b966-f9dbbc47b8d7

	measure 'Avg Response Hours' = AVERAGE ( Tickets[Response Hours (SLA clock)] )
		formatString: #,0.0
		displayFolder: SLA
		lineageTag: fa987155-46da-4d46-babd-98ee7c7f5f61

	measure 'Median Response Hours' = MEDIAN ( Tickets[Response Hours (SLA clock)] )
		formatString: #,0.0
		displayFolder: SLA
		lineageTag: cd9fcb8c-91a6-49eb-83af-ebd594723339

	measure 'Avg Resolution Hours' = CALCULATE ( AVERAGE ( Tickets[Resolution Hours (SLA clock)] ), Tickets[Is Closed] = TRUE (), USERELATIONSHIP ( Tickets[Closed Date], 'Calendar'[Date] ) )
		formatString: #,0.0
		displayFolder: SLA
		lineageTag: 6cffb3ad-3b81-4463-8338-d8db8e3d0887

	measure 'Max Open Age (Days)' = CALCULATE ( MAX ( Tickets[Open Age Days] ), Tickets[Is Open] = TRUE (), REMOVEFILTERS ( 'Calendar' ) )
		formatString: #,0
		displayFolder: Backlog
		lineageTag: ba40f737-3782-48e1-a93d-14073b0308c0

	measure 'After-Hours Tickets' = CALCULATE ( COUNTROWS ( Tickets ), Tickets[Entered After Hours] = TRUE () )
		formatString: #,0
		displayFolder: Client
		lineageTag: 906e0736-9461-4c3f-9c8d-5cde62347823

	measure 'After-Hours %' = DIVIDE ( [After-Hours Tickets], [Tickets Opened] )
		formatString: 0.0%
		displayFolder: Client
		lineageTag: 6010971b-b604-40a8-8341-6403903db7f7

	measure 'Phone %' = DIVIDE ( CALCULATE ( COUNTROWS ( Tickets ), Tickets[Source] = "Phone" ), [Tickets Opened] )
		formatString: 0.0%
		displayFolder: Client
		lineageTag: ee2ed946-1221-4e25-99bc-610e9bc1b70a

	measure 'Requesting Contacts' = DISTINCTCOUNT ( Tickets[Contact] )
		formatString: #,0
		displayFolder: Client
		lineageTag: 30f5163e-24c4-45ea-a326-c1c35c59f967

	measure 'Tickets per Contact' = DIVIDE ( [Tickets Opened], [Requesting Contacts] )
		formatString: #,0.0
		displayFolder: Client
		lineageTag: bf3854b5-226a-440a-8c61-74076c16a104

	measure 'Median Resolution Hours' = CALCULATE ( MEDIAN ( Tickets[Resolution Hours (SLA clock)] ), Tickets[Is Closed] = TRUE (), USERELATIONSHIP ( Tickets[Closed Date], 'Calendar'[Date] ) )
		formatString: #,0.0
		displayFolder: SLA
		lineageTag: 91dd754e-9b50-4731-849c-d45157df93a1

