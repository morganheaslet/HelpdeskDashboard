table TimeEntries
	lineageTag: 5b4e9ca9-4c3e-46c9-84bf-038bdb314d84

	measure 'Hours Logged' = SUM ( TimeEntries[Hours] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 578e9031-cc58-4036-8277-361c18974b28

	measure 'Utilized Hours' = SUM ( TimeEntries[Utilized Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 011dfccb-5df5-481a-ac0f-49c03bfc1309

	measure 'Billable Hours' = SUM ( TimeEntries[Billable Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 456d4835-959b-49e8-8370-3f9b7afe09ee

	measure 'PTO Hours' = SUM ( TimeEntries[PTO Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 2558e014-baa2-4755-8c1d-1db3e141e2ee

	measure 'Ticket Hours' = CALCULATE ( [Hours Logged], TimeEntries[Charge Type] = "ServiceTicket" )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 44205a6a-b6c5-457c-9b71-b42210697d66

	measure 'Project Hours' = CALCULATE ( [Hours Logged], TimeEntries[Charge Type] = "ProjectTicket" )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 0f440f3e-3fcf-41d3-9b3d-372897407f82

	measure 'Labor Cost' = SUM ( TimeEntries[Labor Cost (raw)] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time
		lineageTag: 981ec361-9459-4f9a-9879-05dc42d20c75

	measure 'Uncosted Hours' = SUM ( TimeEntries[Uncosted Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 4c9981a8-8229-41eb-b088-fccb99ab512c

	measure 'Avg Hours per Closed Ticket' = DIVIDE ( [Ticket Hours], [Tickets Closed] )
		formatString: #,0.0
		displayFolder: Client
		lineageTag: eb6c6d20-be40-437b-8340-a8347d56fbee

