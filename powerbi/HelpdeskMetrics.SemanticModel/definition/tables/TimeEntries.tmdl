table TimeEntries
	lineageTag: ac41aa1f-dad8-425e-9f40-e980c8ddc804

	measure 'Hours Logged' = SUM ( TimeEntries[Hours] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: c3fc5b28-3d47-4c86-8267-03fa249b6868

	measure 'Utilized Hours' = SUM ( TimeEntries[Utilized Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: dc2ef5ae-6c94-4de4-86a4-4c1c403c4a03

	measure 'Billable Hours' = SUM ( TimeEntries[Billable Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: e205158b-5936-44f9-ab91-3edbe24171bd

	measure 'PTO Hours' = SUM ( TimeEntries[PTO Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 1ab186a1-ba97-4c92-b99c-86d195bc4652

	measure 'Ticket Hours' = CALCULATE ( [Hours Logged], TimeEntries[Charge Type] = "ServiceTicket" )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 24513989-0e05-4a8a-9b2b-fbf20378d0bd

	measure 'Project Hours' = CALCULATE ( [Hours Logged], TimeEntries[Charge Type] = "ProjectTicket" )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: d3430e81-3690-46db-9b1b-50be2a235e19

	measure 'Labor Cost' = SUM ( TimeEntries[Labor Cost (raw)] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time
		lineageTag: 9fd607e1-5bcb-4df7-9f00-cde9e8dfd16e

	measure 'Uncosted Hours' = SUM ( TimeEntries[Uncosted Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 9a113b75-b1a5-4fce-a41d-171305e81610

	measure 'Avg Hours per Closed Ticket' = DIVIDE ( [Ticket Hours], [Tickets Closed] )
		formatString: #,0.0
		displayFolder: Client
		lineageTag: 4f35cd31-3306-403d-9a27-c540370047ed

