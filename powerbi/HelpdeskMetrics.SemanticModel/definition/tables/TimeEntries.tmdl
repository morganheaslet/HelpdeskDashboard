table TimeEntries
	lineageTag: 3a6f9d21-367e-4bbf-bddd-0bcb534fa9da

	measure 'Hours Logged' = SUM ( TimeEntries[Hours] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 4591ec67-9858-4699-93f4-9fe76829ede5

	measure 'Utilized Hours' = SUM ( TimeEntries[Utilized Hours] )
