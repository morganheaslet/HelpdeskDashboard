table TimeEntries
	lineageTag: 503b7230-efee-4046-9b1a-756aae70667a

	measure 'Hours Logged' = SUM ( TimeEntries[Hours] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: ee748b6d-6c41-4d44-b57b-623def305f44

	measure 'Utilized Hours' = SUM ( TimeEntries[Utilized Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 287527a6-71fa-4784-af39-57c8463bb0ee

	measure 'Billable Hours' = SUM ( TimeEntries[Billable Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 263f3b82-79a5-4650-aae9-a67fad789b37

	measure 'PTO Hours' = SUM ( TimeEntries[PTO Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: c314a417-31a4-4587-a76d-d5dcc250cb4a

	measure 'Ticket Hours' = CALCULATE ( [Hours Logged], TimeEntries[Charge Type] = "ServiceTicket" )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 49535dc2-4f35-48c6-b34e-b2ac93a9f20e

	measure 'Project Hours' = CALCULATE ( [Hours Logged], TimeEntries[Charge Type] = "ProjectTicket" )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: c876e732-0729-46f6-9c7c-e2283fb0767d

	measure 'Labor Cost' = SUM ( TimeEntries[Labor Cost (raw)] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time
		lineageTag: e4dbf109-ae6e-40d0-a1da-bd3d688ec5be

	measure 'Uncosted Hours' = SUM ( TimeEntries[Uncosted Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 0eed4b8d-9cc6-4fc0-8d22-809255fa67c9

	measure 'Avg Hours per Closed Ticket' = DIVIDE ( [Ticket Hours], [Tickets Closed] )
		formatString: #,0.0
		displayFolder: Client
		lineageTag: fdbb8326-f6db-4a11-94f4-a81ab0a101be

