table TimeEntries
	lineageTag: c5f5f3da-a10b-432a-b6e8-60d4ba86f3cc

	measure 'Hours Logged' = SUM ( TimeEntries[Hours] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 9669c133-f6dd-4151-8811-6f2519cfea00

	measure 'Utilized Hours' = SUM ( TimeEntries[Utilized Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 0b3a5b69-3035-418f-a4c4-8d9d618be053

	measure 'Billable Hours' = SUM ( TimeEntries[Billable Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 2d0afa07-0bb4-44e0-a7eb-ef2f6f3f9cc0

	measure 'PTO Hours' = SUM ( TimeEntries[PTO Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 7a756407-a225-4d72-a58d-5230ff47b987

	measure 'Ticket Hours' = CALCULATE ( [Hours Logged], TimeEntries[Charge Type] = "ServiceTicket" )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 23828dc7-290c-4412-948a-0fb267a7cc9b

	measure 'Project Hours' = CALCULATE ( [Hours Logged], TimeEntries[Charge Type] = "ProjectTicket" )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: d4f27e5a-cb0e-46d6-ad00-1069b97b47d0

	measure 'Labor Cost' = SUM ( TimeEntries[Labor Cost (raw)] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time
		lineageTag: 9a76a60a-1f2f-46f5-9506-f9b37a6b676f

	measure 'Uncosted Hours' = SUM ( TimeEntries[Uncosted Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: e3318ea2-35d6-45ae-b134-b32bcb114f79

	measure 'Avg Hours per Closed Ticket' = DIVIDE ( [Ticket Hours], [Tickets Closed] )
		formatString: #,0.0
		displayFolder: Client
		lineageTag: c70804e9-e29b-4057-9ea3-65cef1b30d50

