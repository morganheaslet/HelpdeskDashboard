table TimeEntries
	lineageTag: 9bf509eb-bbed-4d74-b10e-a23fe10b87a6

	measure 'Hours Logged' = SUM ( TimeEntries[Hours] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: c5c1cb5c-89b4-4365-8255-0ceb0310789b

	measure 'Utilized Hours' = SUM ( TimeEntries[Utilized Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 01060fa4-3e67-497f-a7fe-6a3ab424ff11

	measure 'Billable Hours' = SUM ( TimeEntries[Billable Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 012f418b-dae1-4592-88d6-6cd45b18eee5

	measure 'PTO Hours' = SUM ( TimeEntries[PTO Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 911964fb-b4ac-45d1-92d7-681239dd3a85

	measure 'Ticket Hours' = CALCULATE ( [Hours Logged], TimeEntries[Charge Type] = "ServiceTicket" )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: f55267c1-fbf5-4f34-a780-e0c1d5aa8ba4

	measure 'Project Hours' = CALCULATE ( [Hours Logged], TimeEntries[Charge Type] = "ProjectTicket" )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: 117000d6-20e0-45a5-af51-d43673c3e8d1

	measure 'Labor Cost' = SUM ( TimeEntries[Labor Cost (raw)] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time
		lineageTag: f1810a49-794b-4e44-9115-486f70f80d52

	measure 'Uncosted Hours' = SUM ( TimeEntries[Uncosted Hours (raw)] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: da70a783-6a90-41cc-93c8-197fe54fcd59

	measure 'Avg Hours per Closed Ticket' = DIVIDE ( [Ticket Hours], [Tickets Closed] )
		formatString: #,0.0
		displayFolder: Client
		lineageTag: 5f87d10c-f9a2-41e4-beda-44636e741164

