table TimeEntries
	lineageTag: 1e5e1df8-f49d-4b09-9373-e7ce3624f698

	measure 'Hours Logged' = SUM ( TimeEntries[Hours] )
		formatString: #,0.0
		displayFolder: Time
		lineageTag: f095140e-2e4b-4bff-95e6-7e59850d1130

	measure 'Utilized Hours' = SUM ( TimeEntries[Utilized Hours (raw)] )
